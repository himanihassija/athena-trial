# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Optional: Agora Interactive Whiteboard (Console → project → Whiteboard).
# Without these, a voice-driven overlay still opens when Athena joins.
# WHITEBOARD_APP_IDENTIFIER=
# WHITEBOARD_SDK_TOKEN=
# WHITEBOARD_REGION=us-sv
