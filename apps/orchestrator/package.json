{
  "name": "@echosphere/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "test": "node --import tsx scripts/control.test.ts && node --env-file=.env --import tsx scripts/floor.test.ts",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@echosphere/shared-types": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "agora-agents": "^2.3.1",
    "agora-token": "^2.0.5",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "pino-pretty": "^13.0.0"
  }
}
